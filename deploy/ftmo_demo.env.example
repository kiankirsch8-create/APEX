# FTMO DEMO phase — copy to VPS system env / nssm AppEnvironmentExtra.
# NEVER commit real passwords. NEVER set APEX_MT5_LOGIN=511443540 until unlock.
#
# 1) Create an MT5 DEMO account on the SAME broker/server as the FTMO challenge.
# 2) Point the private engine at that demo login for ≥3–5 trading days.
# 3) Confirm Prompt 1–3 guardrails + SL-on-entry via tools/ftmo_demo_validate.py
# 4) Only then: --mark-clean, set APEX_FTMO_ALLOW_LIVE=1, switch to challenge login.

APEX_V76_PRIVATE_DRY_RUN=false
APEX_MT5_SERVER=FTMO-Server
APEX_MT5_LOGIN=<FTMO_DEMO_LOGIN_NOT_511443540>
APEX_MT5_PASSWORD=<set in system env only>

# Leave unset / false during demo:
# APEX_FTMO_ALLOW_LIVE=0
