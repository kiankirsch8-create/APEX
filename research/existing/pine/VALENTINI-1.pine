//@version=6
// ============================================================================
// VALENTINI-1 · Trend model (Chart Fanatics masterclass) · Pine v1 · GRADE: PROXY
// Rule sheet: research/existing/rulesheets/VALENTINI-1_TREND.md  (row ids in comments)
//
// Chart: NQ1! (or MNQ1!), 1-minute (E7). Needs TradingView Premium (request.footprint).
//
// What is HIS rule (STATED)            -> how it is coded here
//  T1 NY session, NQ                   -> entries only in the NY entry window
//  T4 flat by the close                -> flatten 15:55-16:00 NY
//  S1/S2 out of balance vs prev-day VA -> 1m close above prev VAH (long) / below prev VAL (short)
//  L1 LVN of the impulse leg           -> volume profile of the leg (real footprint volume), lowest-volume row
//  L3 no limit order, wait at the LVN  -> enter only when a bar trades into the LVN zone AND shows aggression
//  E5 stop beyond the aggression       -> stop beyond the aggressive footprint row + offset
//  X1/X3 target prior POC / prev high  -> nearest older daily POC or prev day high/low with R >= 2.5 (X4)
//  R1 0.25% risk, R2 2% day cap        -> sizing + daily stop; R4 max losses per day
//
// PROXY / INTERPRETED (my definitions, all are inputs):
//  E1 big 30-contract bubble  -> NOT available in Pine (footprint = volume per price row, not single orders).
//                                Proxy: bar delta >= x * average |delta| AND an imbalance row inside the LVN zone.
//  L1 impulse start           -> lowest low (highest high) of the last N bars at the breakout
//  L1 LVN                     -> lowest-volume row of the leg profile, ignoring the outer 20% of the leg
//  E4 entry timing            -> at the close of the aggression bar
//  X2 trail when no POC       -> fixed 5R target instead (trail rule not stated)
//  X5 breakeven               -> when price makes a new high beyond the leg's high ("additional breakout")
//  T3 15-30 min after open    -> entry window 09:45-13:30 NY
//  S2 "previous day"          -> previous RTH session 09:30-16:00 NY (input)
// NOT implemented: S3 compression-area profile, X6 discretionary early exit, X7 adding.
// ============================================================================
strategy("VALENTINI-1 · Trend model (PROXY)", overlay = true, process_orders_on_close = true,
     default_qty_type = strategy.fixed, default_qty_value = 1, initial_capital = 100000,
     currency = currency.USD, commission_type = strategy.commission.cash_per_contract,
     commission_value = 2.5, slippage = 1, margin_long = 5, margin_short = 5,
     max_bars_back = 500, max_boxes_count = 200)

// ---------------- inputs ----------------
string TZ = "America/New_York"
refSess      = input.session("0930-1600", "Reference balance session NY (S2)", group = "Profile")
rowTicks     = input.int(4, "Profile row size (ticks)", minval = 1, group = "Profile")
vaPct        = input.float(70.0, "Value area %", group = "Profile")
entrySess    = input.session("0945-1330", "Entry window NY (T1/T3/T5)", group = "Timing")
flatSess     = input.session("1555-1600", "Flatten window NY (T4)", group = "Timing")
legLookback  = input.int(30, "Impulse start lookback, bars (L1)", minval = 5, group = "Location")
edgePct      = input.float(0.2, "Ignore leg edges for LVN, fraction (L1)", minval = 0.0, maxval = 0.45, group = "Location")
maxLegBars   = input.int(240, "Max impulse length, bars", minval = 20, group = "Location")
zoneTolTicks = input.int(4, "LVN zone tolerance, ticks", minval = 0, group = "Location")
deltaMult    = input.float(2.0, "Aggression: bar delta >= x * avg |delta| (E1 proxy)", group = "Trigger")
deltaLen     = input.int(20, "Avg |delta| length", minval = 2, group = "Trigger")
needImb      = input.bool(true, "Aggression: require imbalance row in LVN zone (E1 proxy)", group = "Trigger")
stopOffTicks = input.int(2, "Stop beyond aggression row, ticks (E5)", minval = 0, group = "Trigger")
minStopTicks = input.int(8, "Min stop, ticks", minval = 1, group = "Trigger")
maxStopPts   = input.float(40.0, "Max stop, points (else skip)", group = "Trigger")
minRR        = input.float(2.5, "Min R:R to target (X4)", group = "Exit")
fallbackRR   = input.float(5.0, "Target R when no level in direction (X2 proxy)", group = "Exit")
useBE        = input.bool(true, "Breakeven on additional breakout (X5)", group = "Exit")
riskPct      = input.float(0.25, "Risk % per trade (R1)", group = "Risk")
minOne       = input.bool(true, "Trade 1 contract if sizing gives < 1", group = "Risk")
dailyCap     = input.float(2.0, "Max daily loss % (R2)", group = "Risk")
maxLosses    = input.int(3, "Max losing trades per day (R4)", minval = 1, group = "Risk")
showDash     = input.bool(true, "Show dashboard", group = "Display")

float rs = rowTicks * syminfo.mintick

// ---------------- storage ----------------
var array<int>   rbBar = array.new<int>()      // per-bar profile rows, for leg profiles (L1)
var array<int>   rbKey = array.new<int>()
var array<float> rbVol = array.new<float>()
var map<int, float> dayProf = map.new<int, float>()
var array<float> olderPOC = array.new<float>()

// value area from a price-row map (S2)
f_va(map<int, float> m, float rsz, float pct) =>
    float poc = na
    float vah = na
    float val = na
    keys = m.keys()
    keys.sort()
    int n = keys.size()
    if n > 0
        float tot = 0.0
        int pi = 0
        float pv = -1.0
        for i = 0 to n - 1
            float v = m.get(keys.get(i))
            tot += v
            if v > pv
                pv := v
                pi := i
        int lo = pi
        int hi = pi
        float acc = pv
        while acc < tot * pct / 100.0 and (lo > 0 or hi < n - 1)
            float vUp = hi < n - 1 ? m.get(keys.get(hi + 1)) : -1.0
            float vDn = lo > 0 ? m.get(keys.get(lo - 1)) : -1.0
            if vUp >= vDn
                hi += 1
                acc += vUp
            else
                lo -= 1
                acc += vDn
        poc := (keys.get(pi) + 0.5) * rsz
        vah := (keys.get(hi) + 1) * rsz
        val := keys.get(lo) * rsz
    [poc, vah, val]

// LVN of the impulse leg (L1): lowest-volume row between lo and hi, ignoring the outer edgePct
f_lvn(int b0, int b1, float lo, float hi) =>
    float res = na
    int k0 = math.floor(lo / rs)
    int k1 = math.floor(hi / rs)
    int span = k1 - k0 + 1
    if span >= 5 and rbBar.size() > 0
        vols = array.new<float>(span, 0.0)
        for i = 0 to rbBar.size() - 1
            int b = rbBar.get(i)
            if b >= b0 and b <= b1
                int k = rbKey.get(i)
                if k >= k0 and k <= k1
                    vols.set(k - k0, vols.get(k - k0) + rbVol.get(i))
        int a = math.floor(span * edgePct)
        int z = span - 1 - a
        if z > a
            float best = 1e30
            int bi = -1
            for j = a to z
                if vols.get(j) < best
                    best := vols.get(j)
                    bi := j
            if bi >= 0
                res := (k0 + bi) * rs
    res

// ---------------- sessions ----------------
bool inRef   = not na(time(timeframe.period, refSess, TZ))
bool inEntry = not na(time(timeframe.period, entrySess, TZ))
bool inFlat  = not na(time(timeframe.period, flatSess, TZ))
bool newRef  = inRef and not inRef[1]

// ---------------- footprint (one call per script) ----------------
footprint fp = request.footprint(rowTicks)
bool hasFp = not na(fp)
float fpDelta = hasFp ? fp.delta() : na
float avgAbsDelta = ta.sma(math.abs(nz(fpDelta)), deltaLen)
var int fpBars = 0
var int allBars = 0
allBars += 1
if hasFp
    fpBars += 1

// ---------------- previous-day balance (S2) ----------------
var float pPOC = na
var float pVAH = na
var float pVAL = na
var float pHigh = na
var float pLow = na
var float dayHi = na
var float dayLo = na
var bool profComplete = false
var float dayStartEq = strategy.initial_capital
var int dayLosses = 0
var bool longLock = false
var bool shortLock = false

if newRef
    if profComplete and dayProf.size() > 0
        [p, h, l] = f_va(dayProf, rs, vaPct)
        if not na(pPOC)
            olderPOC.unshift(pPOC)
            if olderPOC.size() > 10
                olderPOC.pop()
        pPOC := p
        pVAH := h
        pVAL := l
        pHigh := dayHi
        pLow := dayLo
    profComplete := true
    dayProf.clear()
    dayHi := na
    dayLo := na
    dayStartEq := strategy.equity
    dayLosses := 0
    longLock := false
    shortLock := false

if inRef
    dayHi := na(dayHi) ? high : math.max(dayHi, high)
    dayLo := na(dayLo) ? low : math.min(dayLo, low)

// this bar's volume at price: real footprint rows, or (no data) bar volume spread over the bar's range
barKeys = array.new<int>()
barVols = array.new<float>()
if hasFp
    for r in fp.rows()
        barKeys.push(math.floor(((r.up_price() + r.down_price()) / 2) / rs))
        barVols.push(r.total_volume())
else if volume > 0
    int k0 = math.floor(low / rs)
    int k1 = math.floor(high / rs)
    int n = math.min(k1 - k0 + 1, 200)
    for j = 0 to n - 1
        barKeys.push(k0 + j)
        barVols.push(volume / n)
if barKeys.size() > 0
    for j = 0 to barKeys.size() - 1
        int k = barKeys.get(j)
        float v = barVols.get(j)
        rbBar.push(bar_index)
        rbKey.push(k)
        rbVol.push(v)
        if inRef
            dayProf.put(k, nz(dayProf.get(k)) + v)
if bar_index % 60 == 0 and rbBar.size() > 0     // trim old rows in batches (speed)
    int cut = 0
    int lim = bar_index - maxLegBars - legLookback
    while cut < rbBar.size() and rbBar.get(cut) < lim
        cut += 1
    if cut > 0
        rbBar := rbBar.slice(cut, rbBar.size()).copy()
        rbKey := rbKey.slice(cut, rbKey.size()).copy()
        rbVol := rbVol.slice(cut, rbVol.size()).copy()

// ---------------- daily risk (R2, R4) ----------------
if strategy.closedtrades > strategy.closedtrades[1]
    if strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        dayLosses += 1
bool canTrade = dayLosses < maxLosses and strategy.equity - dayStartEq > -dailyCap / 100.0 * dayStartEq

// ---------------- setup state ----------------
float lowestL = ta.lowest(low, legLookback)
int lowestOff = ta.lowestbars(low, legLookback)
float highestH = ta.highest(high, legLookback)
int highestOff = ta.highestbars(high, legLookback)

var int dir = 0
var float legStart = na
var int legStartBar = na
var float legExt = na
var float lvnLo = na
var float lvnHi = na
var box lvnBox = na
bool flat = strategy.position_size == 0
bool newExt = false

// unlock a side once price is back inside value (one trade per excursion)
if close <= pVAH
    longLock := false
if close >= pVAL
    shortLock := false

if dir == 0 and flat and inEntry and canTrade and not na(pVAH)
    if close > pVAH and not longLock          // S1: out of balance up
        dir := 1
        legStart := lowestL
        legStartBar := bar_index + lowestOff
        legExt := high
        newExt := true
        lvnBox := na
    else if close < pVAL and not shortLock    // S1: out of balance down
        dir := -1
        legStart := highestH
        legStartBar := bar_index + highestOff
        legExt := low
        newExt := true
        lvnBox := na
else if dir == 1
    if high > legExt
        legExt := high
        newExt := true
    if low < legStart or bar_index - legStartBar > maxLegBars
        dir := 0
        longLock := true
else if dir == -1
    if low < legExt
        legExt := low
        newExt := true
    if high > legStart or bar_index - legStartBar > maxLegBars
        dir := 0
        shortLock := true
if not inEntry and dir != 0
    dir := 0

// L1: recompute the LVN when the impulse extends
if newExt and dir != 0
    float lo = dir == 1 ? legStart : legExt
    float hi = dir == 1 ? legExt : legStart
    lvnLo := f_lvn(legStartBar, bar_index, lo, hi)
    lvnHi := na(lvnLo) ? na : lvnLo + rs
    if not na(lvnLo)
        if na(lvnBox)
            lvnBox := box.new(bar_index, lvnHi, bar_index + 1, lvnLo, border_color = color.new(color.yellow, 0), bgcolor = color.new(color.yellow, 80))
        else
            box.set_top(lvnBox, lvnHi)
            box.set_bottom(lvnBox, lvnLo)
if dir != 0 and not na(lvnBox)
    box.set_right(lvnBox, bar_index)

// ---------------- trigger (L3 + E1 proxy + E5) ----------------
bool trig = false
float stopPx = na
if dir != 0 and not newExt and flat and inEntry and canTrade and not na(lvnLo) and hasFp
    float zLo = lvnLo - zoneTolTicks * syminfo.mintick
    float zHi = lvnHi + zoneTolTicks * syminfo.mintick
    bool touches = low <= zHi and high >= zLo
    bool deltaOk = dir == 1 ? (fpDelta > 0 and fpDelta >= deltaMult * avgAbsDelta) : (fpDelta < 0 and fpDelta <= -deltaMult * avgAbsDelta)
    if touches and deltaOk
        float aggEdge = na
        for r in fp.rows()
            float rd = r.down_price()
            float ru = r.up_price()
            bool inZone = ru >= zLo and rd <= zHi
            bool isAgg = dir == 1 ? r.has_buy_imbalance() : r.has_sell_imbalance()
            if inZone and (isAgg or not needImb)
                if dir == 1
                    aggEdge := na(aggEdge) ? rd : math.min(aggEdge, rd)
                else
                    aggEdge := na(aggEdge) ? ru : math.max(aggEdge, ru)
        if not na(aggEdge)
            stopPx := dir == 1 ? aggEdge - stopOffTicks * syminfo.mintick : aggEdge + stopOffTicks * syminfo.mintick
            trig := true

if trig
    float minD = minStopTicks * syminfo.mintick
    stopPx := dir == 1 ? math.min(stopPx, close - minD) : math.max(stopPx, close + minD)
    if math.abs(close - stopPx) > maxStopPts
        trig := false

// X1/X3/X4 target: nearest prior POC or prev-day extreme in the trade direction with R >= minRR
f_target(int d, float entry, float dist) =>
    float best = na
    cands = array.new<float>()
    cands.push(d == 1 ? pHigh : pLow)
    cands.push(pPOC)
    for c0 in olderPOC
        cands.push(c0)
    for c in cands
        if not na(c)
            float rr = d == 1 ? (c - entry) / dist : (entry - c) / dist
            if rr >= minRR
                if na(best) or math.abs(c - entry) < math.abs(best - entry)
                    best := c
    na(best) ? (d == 1 ? entry + fallbackRR * dist : entry - fallbackRR * dist) : best

var float tgtPx = na
var float stp = na
var float entryExt = na
var bool beDone = false

if trig
    float dist = math.abs(close - stopPx)
    float q = math.floor(riskPct / 100.0 * strategy.equity / (dist * syminfo.pointvalue))
    q := q < 1 ? (minOne ? 1 : 0) : q
    if q > 0
        tgtPx := f_target(dir, close, dist)
        stp := stopPx
        entryExt := legExt
        beDone := false
        if dir == 1
            strategy.entry("L", strategy.long, qty = q, comment = "V1 long")
            strategy.exit("XL", "L", stop = stp, limit = tgtPx)
            longLock := true
        else
            strategy.entry("S", strategy.short, qty = q, comment = "V1 short")
            strategy.exit("XS", "S", stop = stp, limit = tgtPx)
            shortLock := true
        dir := 0

// ---------------- management (X5) ----------------
if strategy.position_size > 0
    if useBE and not beDone and high > entryExt
        stp := math.max(stp, strategy.position_avg_price + syminfo.mintick)
        beDone := true
    strategy.exit("XL", "L", stop = stp, limit = tgtPx)
if strategy.position_size < 0
    if useBE and not beDone and low < entryExt
        stp := math.min(stp, strategy.position_avg_price - syminfo.mintick)
        beDone := true
    strategy.exit("XS", "S", stop = stp, limit = tgtPx)

// T4: flat by the close
if inFlat and strategy.position_size != 0
    strategy.close_all(comment = "EOD flat")

// ---------------- plots ----------------
plot(pVAH, "Prev VAH", color.new(color.teal, 0), 1, plot.style_linebr)
plot(pVAL, "Prev VAL", color.new(color.teal, 0), 1, plot.style_linebr)
plot(pPOC, "Prev POC", color.new(color.orange, 0), 2, plot.style_linebr)
plot(strategy.position_size != 0 ? stp : na, "Stop", color.new(color.red, 0), 1, plot.style_linebr)
plot(strategy.position_size != 0 ? tgtPx : na, "Target", color.new(color.lime, 0), 1, plot.style_linebr)
plotshape(newRef, "NY open", shape.triangleup, location.bottom, color.new(color.gray, 40), size = size.tiny)

// ---------------- dashboard ----------------
var table dash = table.new(position.top_right, 2, 12, bgcolor = color.new(color.black, 15), border_width = 1)
f_row(int r, string a, string b, color c) =>
    table.cell(dash, 0, r, a, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, b, text_color = c, text_size = size.small, text_halign = text.align_right)

if showDash and barstate.islast
    int ct = strategy.closedtrades
    float wr = ct > 0 ? 100.0 * strategy.wintrades / ct : na
    float pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    float aw = strategy.wintrades > 0 ? strategy.grossprofit / strategy.wintrades : na
    float al = strategy.losstrades > 0 ? strategy.grossloss / strategy.losstrades : na
    float np = strategy.netprofit
    color pc = np >= 0 ? color.lime : color.red
    f_row(0, "VALENTINI-1 trend", "grade: PROXY", color.yellow)
    f_row(1, "Net P&L", str.tostring(np, "#,##0") + " $  (" + str.tostring(100 * np / strategy.initial_capital, "0.00") + "%)", pc)
    f_row(2, "Closed trades", str.tostring(ct), color.white)
    f_row(3, "Win rate", na(wr) ? "-" : str.tostring(wr, "0.0") + "%", color.white)
    f_row(4, "Profit factor", na(pf) ? "-" : str.tostring(pf, "0.00"), color.white)
    f_row(5, "Avg win / avg loss", (na(aw) ? "-" : str.tostring(aw, "#,##0")) + " / " + (na(al) ? "-" : str.tostring(al, "#,##0")), color.white)
    f_row(6, "Max drawdown", str.tostring(strategy.max_drawdown, "#,##0") + " $", color.orange)
    f_row(7, "Open position", str.tostring(strategy.position_size), color.white)
    f_row(8, "Footprint data", str.tostring(100.0 * fpBars / math.max(allBars, 1), "0.0") + "% of bars", fpBars > 0 ? color.white : color.red)
    f_row(9, "Prev POC / VAH / VAL", na(pPOC) ? "building..." : str.tostring(pPOC, format.mintick) + " / " + str.tostring(pVAH, format.mintick) + " / " + str.tostring(pVAL, format.mintick), color.white)
    f_row(10, "Setup state", dir == 1 ? "long armed (waiting at LVN)" : dir == -1 ? "short armed (waiting at LVN)" : "idle", color.white)
    f_row(11, "Chart timeframe", timeframe.period == "1" ? "1m OK" : timeframe.period + " (use 1m!)", timeframe.period == "1" ? color.white : color.red)
